{
  "name": "ontographia-plm-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "build": "npm run build:notify && npm run typecheck && vite build",
    "build:notify": "node scripts/build-notify-bundle.mjs",
    "verify": "node scripts/verify.mjs",
    "test:farmbot": "node --test 'farmbot/test/*.test.mjs'",
    "test:worker": "node --experimental-strip-types --test 'worker/test/*.test.mjs'",
    "test:worker:contract": "node worker/test/contract.mjs",
    "agent:farmbot": "node farmbot/scripts/agent-farmbot.mjs",
    "release:assets": "node farmbot/scripts/release-assets.mjs",
    "release:verify": "node farmbot/scripts/verify-release-assets.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:farmbot": "node scripts/smoke-farmbot.mjs",
    "smoke:webgpu": "node scripts/smoke-webgpu.mjs",
    "smoke:wrangler": "node scripts/smoke-wrangler.mjs",
    "eval:intents": "node scripts/eval-intents.mjs",
    "smoke:live": "SMOKE_BASE_URL=https://ontographia-plm-demo.egdesentry.workers.dev/ node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@edgesentry/ontographia-wasm": "0.1.9",
    "@mlc-ai/web-llm": "^0.2.88",
    "@relate/relate-wasm": "1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.4.5-r.1",
    "@relate/relate": "1.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.0",
    "typescript": "~5.6.3",
    "vite": "^8.3.7",
    "wrangler": "^4.160.0",
    "yaml": "2.9.1"
  }
}
